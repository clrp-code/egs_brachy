# Boundary of the source model(s) for region discovery and volume correction.
# A box enclosing OncoSeed_6711.geom, OncoSeed_6711_wrapped.geom
# (r_max = 0.041 cm, z from -0.2285 to 0.2285 cm) with a 0.001 cm margin.
# A box, not a cylinder, so that the Sobol sequence is used.
:start shape:
    type = box
    box size = 0.084000 0.084000 0.459000
    :start transformation:
        translation = 0 0 0.000000
    :stop transformation:
:stop shape:
