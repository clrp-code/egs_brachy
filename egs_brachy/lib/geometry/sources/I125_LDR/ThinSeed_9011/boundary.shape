# Boundary of the source model(s) for region discovery and volume correction.
# A box enclosing ThinSeed_9011.geom
# (r_max = 0.0255 cm, z from -0.2275 to 0.2275 cm) with a 0.001 cm margin.
# A box, not a cylinder, so that the Sobol sequence is used.
:start shape:
    type = box
    box size = 0.053000 0.053000 0.457000
    :start transformation:
        translation = 0 0 0.000000
    :stop transformation:
:stop shape:
