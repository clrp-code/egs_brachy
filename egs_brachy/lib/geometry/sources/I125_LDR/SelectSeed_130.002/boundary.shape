# Boundary of the source model(s) for region discovery and volume correction.
# A box enclosing SelectSeed_130.002.geom, SelectSeed_130.002_wrapped.geom
# (r_max = 0.041 cm, z from -0.226 to 0.226 cm) with a 0.001 cm margin.
# A box, not a cylinder, so that the Sobol sequence is used.
:start shape:
    type = box
    box size = 0.084000 0.084000 0.454000
    :start transformation:
        translation = 0 0 0.000000
    :stop transformation:
:stop shape:
