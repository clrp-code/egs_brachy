# Boundary of the source model(s) for region discovery and volume correction.
# A box enclosing Best_steel-clad_seed.geom
# (r_max = 0.025 cm, z from -0.15 to 0.15 cm) with a 0.001 cm margin.
# A box, not a cylinder, so that the Sobol sequence is used.
:start shape:
    type = box
    box size = 0.052000 0.052000 0.302000
    :start transformation:
        translation = 0 0 0.000000
    :stop transformation:
:stop shape:
