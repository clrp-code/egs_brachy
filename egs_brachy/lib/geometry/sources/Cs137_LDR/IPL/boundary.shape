# Boundary of the source model(s) for region discovery and volume correction.
# A box enclosing CS137_IPL.geom
# (r_max = 0.1525 cm, z from -1.049 to 0.939 cm) with a 0.001 cm margin.
# A box, not a cylinder, so that the Sobol sequence is used.
:start shape:
    type = box
    box size = 0.307000 0.307000 1.990000
    :start transformation:
        translation = 0 0 -0.055000
    :stop transformation:
:stop shape:
