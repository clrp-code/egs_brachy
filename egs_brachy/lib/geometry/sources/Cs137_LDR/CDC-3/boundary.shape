# Boundary of the source model(s) for region discovery and volume correction.
# A box enclosing CS137_CDC-3.geom
# (r_max = 0.09 cm, z from -0.25 to 0.25 cm) with a 0.001 cm margin.
# A box, not a cylinder, so that the Sobol sequence is used.
:start shape:
    type = box
    box size = 0.182000 0.182000 0.502000
    :start transformation:
        translation = 0 0 0.000000
    :stop transformation:
:stop shape:
