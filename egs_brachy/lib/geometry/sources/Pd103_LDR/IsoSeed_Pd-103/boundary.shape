# Boundary of the source model(s) for region discovery and volume correction.
# A box enclosing IsoSeed_Pd-103.geom
# (r_max = 0.04 cm, z from -0.228 to 0.228 cm) with a 0.001 cm margin.
# A box, not a cylinder, so that the Sobol sequence is used.
:start shape:
    type = box
    box size = 0.082000 0.082000 0.458000
    :start transformation:
        translation = 0 0 0.000000
    :stop transformation:
:stop shape:
