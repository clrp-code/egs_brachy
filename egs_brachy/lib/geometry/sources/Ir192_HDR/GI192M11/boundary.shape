# Boundary of the source model(s) for region discovery and volume correction.
# A box enclosing GI192M11.geom
# (r_max = 0.050001 cm, z from -6.23 to 0.259 cm) with a 0.001 cm margin.
# A box, not a cylinder, so that the Sobol sequence is used.
:start shape:
    type = box
    box size = 0.102002 0.102002 6.491000
    :start transformation:
        translation = 0 0 -2.985500
    :stop transformation:
:stop shape:
