# Boundary of the source model(s) for region discovery and volume correction.
# A box enclosing MBDCA-WG.geom
# (r_max = 0.050001 cm, z from -0.465 to 0.235 cm) with a 0.001 cm margin.
# A box, not a cylinder, so that the Sobol sequence is used.
:start shape:
    type = box
    box size = 0.102002 0.102002 0.702000
    :start transformation:
        translation = 0 0 -0.115000
    :stop transformation:
:stop shape:
