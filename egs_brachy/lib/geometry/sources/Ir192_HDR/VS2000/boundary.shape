# Boundary of the source model(s) for region discovery and volume correction.
# A box enclosing VS2000.geom
# (r_max = 0.0295 cm, z from -5 to 0.35 cm) with a 0.001 cm margin.
# A box, not a cylinder, so that the Sobol sequence is used.
:start shape:
    type = box
    box size = 0.061000 0.061000 5.352000
    :start transformation:
        translation = 0 0 -2.325000
    :stop transformation:
:stop shape:
