# Boundary of the source model(s) for region discovery and volume correction.
# A box enclosing Flexisource.geom
# (r_max = 0.0425 cm, z from -0.7201 to 0.2399 cm) with a 0.001 cm margin.
# A box, not a cylinder, so that the Sobol sequence is used.
:start shape:
    type = box
    box size = 0.087000 0.087000 0.962000
    :start transformation:
        translation = 0 0 -0.240100
    :stop transformation:
:stop shape:
