# Boundary of the source model(s) for region discovery and volume correction.
# A box enclosing microSelectron-v2.geom
# (r_max = 0.045 cm, z from -0.45 to 0.2 cm) with a 0.001 cm margin.
# A box, not a cylinder, so that the Sobol sequence is used.
:start shape:
    type = box
    box size = 0.092000 0.092000 0.652000
    :start transformation:
        translation = 0 0 -0.125000
    :stop transformation:
:stop shape:
