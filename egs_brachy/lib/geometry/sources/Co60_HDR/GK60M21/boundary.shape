# Boundary of the source model(s) for region discovery and volume correction.
# A box enclosing GK60M21.geom
# (r_max = 0.050001 cm, z from -0.735 to 0.259 cm) with a 0.001 cm margin.
# A box, not a cylinder, so that the Sobol sequence is used.
:start shape:
    type = box
    box size = 0.102002 0.102002 0.996000
    :start transformation:
        translation = 0 0 -0.238000
    :stop transformation:
:stop shape:
