# Boundary of the source model(s) for region discovery and volume correction.
# A box enclosing Ralston_type-2.geom
# (r_max = 0.150001 cm, z from -0.8 to 0.4 cm) with a 0.001 cm margin.
# A box, not a cylinder, so that the Sobol sequence is used.
:start shape:
    type = box
    box size = 0.302002 0.302002 1.202000
    :start transformation:
        translation = 0 0 -0.200000
    :stop transformation:
:stop shape:
